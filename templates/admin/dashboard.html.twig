{# @var ea \EasyCorp\Bundle\EasyAdminBundle\Context\AdminContext #}
{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title 'dashboard.title'|trans %}

{% block page_content %}
    {% if not is_productive %}
        <div class="alert alert-warning rounded mb-2">
            <h1>Testumgebung. Kein produktiver Betrieb! Nicht für echte Eingaben verwenden!</h1>
        </div>
    {% endif %}

    <div class="alert alert-info rounded">
        <h1>{% trans %}dashboard.welcome{% endtrans %}</h1>
        <h4>{% trans %}dashboard.explanation{% endtrans %}</h4>
        <p>{% trans with {'%email%': support_email} %}dashboard.contact_info{% endtrans %}</p>

        <hr>
        <b>{% trans %}dashboard.warning{% endtrans %}</b>
    </div>

    {% macro format_day(val) %}
        {% if val is not null %}
            {{ val | format_number }} Tage
        {% endif %}
    {% endmacro %}

    {% if is_granted("ROLE_SHOW_PAYMENT_ORDERS") %}
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Statistiken</h5>

                <h6>Anzahl Aufträge</h6>
                <table class="table table-sm table-striped table-hover">
                    <thead>
                    <tr>
                        <th>Metrik</th>
                        <th>Letzten 24h</th>
                        <th>Letzten 3 Tage</th>
                        <th>Letzten 7 Tage</th>
                        <th>Letzten 30 Tage</th>
                        <th>Letzten 90 Tage</th>
                        <th>Letzten 365 Tage</th>
                        <th>Gesamt</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>Eingereicht</td>
                        <td>{{ statistics.submittedPaymentOrdersCount("-1 days") }}</td>
                        <td>{{ statistics.submittedPaymentOrdersCount("-3 days") }}</td>
                        <td>{{ statistics.submittedPaymentOrdersCount("-7 days") }}</td>
                        <td>{{ statistics.submittedPaymentOrdersCount("-30 days") }}</td>
                        <td>{{ statistics.submittedPaymentOrdersCount("-90 days") }}</td>
                        <td>{{ statistics.submittedPaymentOrdersCount("-365 days") }}</td>
                        <td>{{ statistics.submittedPaymentOrdersCount() }}</td>
                    </tr>
                    <tr>
                        <td>Rechnerisch Geprüft</td>
                        <td>{{ statistics.mathematicallyCheckedPaymentOrdersCount("-1 days") }}</td>
                        <td>{{ statistics.mathematicallyCheckedPaymentOrdersCount("-3 days") }}</td>
                        <td>{{ statistics.mathematicallyCheckedPaymentOrdersCount("-7 days") }}</td>
                        <td>{{ statistics.mathematicallyCheckedPaymentOrdersCount("-30 days") }}</td>
                        <td>{{ statistics.mathematicallyCheckedPaymentOrdersCount("-90 days") }}</td>
                        <td>{{ statistics.mathematicallyCheckedPaymentOrdersCount("-365 days") }}</td>
                        <td>{{ statistics.mathematicallyCheckedPaymentOrdersCount() }}</td>
                    </tr>
                    <tr>
                        <td>Sachlich Geprüft</td>
                        <td>{{ statistics.factuallyCheckedPaymentOrdersCount("-1 days") }}</td>
                        <td>{{ statistics.factuallyCheckedPaymentOrdersCount("-3 days") }}</td>
                        <td>{{ statistics.factuallyCheckedPaymentOrdersCount("-7 days") }}</td>
                        <td>{{ statistics.factuallyCheckedPaymentOrdersCount("-30 days") }}</td>
                        <td>{{ statistics.factuallyCheckedPaymentOrdersCount("-90 days") }}</td>
                        <td>{{ statistics.factuallyCheckedPaymentOrdersCount("-365 days") }}</td>
                        <td>{{ statistics.factuallyCheckedPaymentOrdersCount() }}</td>
                    </tr>
                    <tr>
                        <td>Überwiesen</td>
                        <td>{{ statistics.bookedPaymentOrdersCount("-1 days") }}</td>
                        <td>{{ statistics.bookedPaymentOrdersCount("-3 days") }}</td>
                        <td>{{ statistics.bookedPaymentOrdersCount("-7 days") }}</td>
                        <td>{{ statistics.bookedPaymentOrdersCount("-30 days") }}</td>
                        <td>{{ statistics.bookedPaymentOrdersCount("-90 days") }}</td>
                        <td>{{ statistics.bookedPaymentOrdersCount("-365 days") }}</td>
                        <td>{{ statistics.bookedPaymentOrdersCount() }}</td>
                    </tr>
                    </tbody>
                </table>

                <h6>Geldbeträge (eingereicht)</h6>

                <table class="table table-sm table-striped table-hover">
                    <thead>
                    <tr>
                        <th>Metrik</th>
                        <th>Letzten 24h</th>
                        <th>Letzten 3 Tage</th>
                        <th>Letzten 7 Tage</th>
                        <th>Letzten 30 Tage</th>
                        <th>Letzten 90 Tage</th>
                        <th>Letzten 365 Tage</th>
                        <th>Gesamt</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>Summe</td>
                        <td>{{ statistics.paymentOrdersTotalValue("-1days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersTotalValue("-3days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersTotalValue("-7 days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersTotalValue("-30 days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersTotalValue("-90 days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersTotalValue("-365 days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersTotalValue() | format_currency("EUR") }}</td>
                    </tr>
                    <tr>
                        <td>Durchschnitt</td>
                        <td>{{ statistics.paymentOrdersAverageValue("-1days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersAverageValue("-3days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersAverageValue("-7 days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersAverageValue("-30 days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersAverageValue("-90 days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersAverageValue("-365 days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersAverageValue() | format_currency("EUR") }}</td>
                    </tr>
                    <tr>
                        <td>Standardabweichung</td>
                        <td>{{ statistics.paymentOrdersStdDevValue("-1days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersStdDevValue("-3days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersStdDevValue("-7 days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersStdDevValue("-30 days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersStdDevValue("-90 days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersStdDevValue("-365 days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersStdDevValue() | format_currency("EUR") }}</td>
                    </tr>
                    <tr>
                        <td>Minimum</td>
                        <td>{{ statistics.paymentOrdersMinValue("-1days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersMinValue("-3days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersMinValue("-7 days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersMinValue("-30 days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersMinValue("-90 days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersMinValue("-365 days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersMinValue() | format_currency("EUR") }}</td>
                    </tr>
                    <tr>
                        <td>Maximum</td>
                        <td>{{ statistics.paymentOrdersMaxValue("-1days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersMaxValue("-3days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersMaxValue("-7 days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersMaxValue("-30 days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersMaxValue("-90 days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersMaxValue("-365 days") | format_currency("EUR") }}</td>
                        <td>{{ statistics.paymentOrdersMaxValue() | format_currency("EUR") }}</td>
                    </tr>
                    </tbody>
                </table>

                <h6>Bearbeitungsdauer (von Einreichung zu Überweisung)</h6>
                <table class="table table-sm table-striped table-hover">
                    <thead>
                    <tr>
                        <th>Metrik</th>
                        <th>Letzten 3 Tage</th>
                        <th>Letzten 7 Tage</th>
                        <th>Letzten 30 Tage</th>
                        <th>Letzten 90 Tage</th>
                        <th>Letzten 365 Tage</th>
                        <th>Gesamt</th>
                    </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Durchschnitt</td>
                            <td>{{ _self.format_day(statistics.averageProcessingTime("-3 days")) }}</td>
                            <td>{{ _self.format_day(statistics.averageProcessingTime("-7 days")) }}</td>
                            <td>{{ _self.format_day(statistics.averageProcessingTime("-30 days")) }}</td>
                            <td>{{ _self.format_day(statistics.averageProcessingTime("-90 days")) }}</td>
                            <td>{{ _self.format_day(statistics.averageProcessingTime("-365 days")) }}</td>
                            <td>{{ _self.format_day(statistics.averageProcessingTime()) }}</td>
                        </tr>
                        <tr>
                            <td>Standardabweichung</td>
                            <td>{{ _self.format_day(statistics.stdDevProcessingTime("-3 days")) }}</td>
                            <td>{{ _self.format_day(statistics.stdDevProcessingTime("-7 days")) }}</td>
                            <td>{{ _self.format_day(statistics.stdDevProcessingTime("-30 days")) }}</td>
                            <td>{{ _self.format_day(statistics.stdDevProcessingTime("-90 days")) }}</td>
                            <td>{{ _self.format_day(statistics.stdDevProcessingTime("-365 days")) }}</td>
                            <td>{{ _self.format_day(statistics.stdDevProcessingTime()) }}</td>
                        </tr>
                    </tbody>
                </table>

            </div>
        </div>

    {% endif %}

{% endblock %}
