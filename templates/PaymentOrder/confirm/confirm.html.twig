{% extends "main_card.html.twig" %}
{% set confirmation_nr = 1 %}

{% block title %}Zahlungsauftrag {{ entity.iDString }}{% endblock %}

{% block card_type %}
    {% if entity.confirmed %}
        bg-success text-white
    {% else %}
        bg-primary text-white
    {% endif %}
{% endblock %}

{% block card_border %}
    {% if entity.confirmed %}
        border-success
    {% else %}
        border-primary
    {% endif %}
{% endblock %}

{% block card_title %}<i class="fas fa-file-invoice-dollar fa-fw"></i>
    Zahlungsauftrag
    {{ entity.iDString }}
    (<i>{% if entity.confirmed %}Bestätigt{% else %}Bestätigung {{ entity.numberOfConfirmations + 1 }} / {{ entity.requiredConfirmations }}{% endif %}</i>)
{% endblock %}

{% block prefix_content%}
    {% include("/PaymentOrder/confirm/_payment_order_status.html.twig")%}
{% endblock %}

{% block card_content %}

    <h4>{% trans %}payment_order.confirm.title_1{% endtrans %}</h4>
    <p class="">
        {% trans with {'%fsb_email%': entity.department.fsr ? fsb_email : hhv_email } %}payment_order.confirm.hint_1{% endtrans %}
    </p>

    <h4>{{ entity.iDString }} <small class="text-body-secondary">{{ entity.projectName }}</small></h4>

    <table class="table table-striped table-hover table-sm">
        <tbody>
        <tr>
            <td>{% trans %}payment_order.name.label{% endtrans %}</td>
            <td>{{ entity.submitterName }} ({{ entity.submitterEmail }})</td>
        </tr>
        <tr>
            <td>{% trans %}payment_order.department.label{% endtrans %}</td>
            <td>{{ entity.department.name }}</td>
        </tr>
        </tbody>

        <tbody class="table-group-divider">
        <tr>
            <td>{% trans %}payment_order.project_name.label{% endtrans %}</td>
            <td>{{ entity.projectName }}</td>
        </tr>

        {# For legacy payment orders #}
        {% if entity.fsrKomResolution %}
            <tr>
                <td>{% trans %}payment_order.fsr_kom.label{% endtrans %}</td>
                <td>{{ entity.fsrKomResolution ? 'Yes'|trans : 'No'|trans }}</td>
            </tr>
        {% endif %}
        </tbody>

        <tbody class="table-group-divider">
        <tr>
            <td>Mittelfreigabe / Finanzantrag</td>
            <td>{{ entity.fundingId }}
                {% if entity.resolutionDate %}
                    <span title="{% trans %}payment_order.resolution_date.label{% endtrans %}">({{ entity.resolutionDate | format_date }})</span>
                {% endif %}
            </td>
        </tr>

        <tr>
            <td>Gesamtbetrag</td>
            <td>{{ (entity.amount/100) | format_currency("EUR") }}</td>
        </tr>

        <tr>
            <td>Unterstützende Mittelfreigabe</td>
            <td>
                {{ entity.supportingFundingId ?? '' }}
                {% if entity.supportingFundingDate %}
                    <span title="{% trans %}payment_order.resolution_date.label{% endtrans %}">({{ entity.supportingFundingDate | format_date }})</span>
                {% endif %}
            </td>
        </tr>

        <tr>
            <td>Unterstützer Betrag</td>
            <td>{% if entity.supportingAmount %}{{ (entity.supportingAmount/100) | format_currency("EUR") }}{% endif %}</td>
        </tr>

        </tbody>

        <tbody class="table-group-divider">
        <tr>
            <td>{% trans %}bank_info.account_owner.label{% endtrans %}</td>
            <td>{{ entity.bankInfo.accountOwner }}</td>
        </tr>
        <tr>
            <td>{% trans %}bank_info.address.label{% endtrans %}</td>
            <td>{{ entity.bankInfo.address }}</td>
        </tr>
        <tr>
            <td>{% trans %}payment_order.invoice_number.label{% endtrans %}</td>
            <td>{{ entity.invoiceNumber ?? '' }}</td>
        </tr>
        <tr>
            <td>{% trans %}payment_order.customer_number.label{% endtrans %}</td>
            <td>{{ entity.customerNumber ?? '' }}</td>
        </tr>
        </tbody>



        <tbody class="table-group-divider">
        <tr>
            <td>{% trans %}bank_info.iban.label{% endtrans %}</td>
            <td>
                {{ entity.bankInfo.ibanFormatted }}
                {% if entity.bankInfo.bic is not empty %}
                    (BIC: {{ entity.bankInfo.bic }})
                {% endif %}
            </td>
        </tr>

        <tr>
            <td>{% trans %}bank_info.reference.label{% endtrans %}</td>
            <td>{{ entity.bankInfo.reference }}</td>
        </tr>
        </tbody>

        <tbody class="table-group-divider">
        <tr>
            <td>{% trans %}payment_order.submitted_date.label{% endtrans %}</td>
            <td>{{ entity.creationDate | format_datetime }}</td>
        </tr>
        <tr>
            <td>{% trans %}payment_order.id.label{% endtrans %}</td>
            <td>{{ entity.iDString }}</td>
        </tr>
        </tbody>
    </table>


    <h4>{% trans %}payment_order.confirm.title_2{% endtrans %}</h4>
    <p class="">
        {% trans with {'%fsb_email%': 'fsb@stura.uni-jena.de'} %}payment_order.confirm.hint_2{% endtrans %}
    </p>
    <a href="{{ path('file_payment_order_references',
        {'id': entity.id, 'secret': app.request.query.get('secret'), 'token': token.id}
    ) }}" class="btn btn-secondary" target="_blank">
        <i class="fas fa-download"></i> {% trans %}payment_order.confirm.download_references{% endtrans %}
    </a>

    <br><br>
    <h4>{% trans %}payment_order.confirm.title_3{% endtrans %}</h4>

    <p class="">
        {% trans with {'%fsb_email%': 'fsb@stura.uni-jena.de'} %}payment_order.confirm.hint_3{% endtrans %}
    </p>

    <h4>Schritt 4: Auftragsformular ausdrucken und unterschreiben</h4>

    <p>Sobald alle Bestätigungen vorliegen, erhältst du per E-Mail ein Zahlungsauftragsformular, dass ihr ausdruckt und unterschreibt.
        Anschließend reicht ihr das unterschriebene Formular zusammen mit allen nicht digital vorliegenden Belegen bei den StuRa-Finanzen ein.</p>

    {% if entity.confirmed %}
        <p class="mb-1">Das Bestätigungsformular wurde erstellt und kann heruntergeladen werden:</p>

        <a href="{{ path('file_payment_order_form',
            {'id': entity.id, 'secret': app.request.query.get('secret'), 'token': token.id}
        ) }}" class="btn btn-secondary" target="_blank">
            <i class="fas fa-download"></i> {% trans %}payment_order.confirm.download_form{% endtrans %}
        </a>
    {% else %}
        <p class="mb-1 text-danger"><b>Achtung: </b> Das endgültige Bestätigungsformular wurde noch nicht erstellt.
            Bitte unterschreibe das Bestätigungsformular, dass du nach allen Bestätigungen per E-Mail erhältst, da dies
            dann auch genaue Informationen über die Bestätigungen enthält.
            Du kannst aber <a href="{{ path('file_payment_order_form',
                {'id': entity.id, 'secret': app.request.query.get('secret'), 'token': token.id}
            ) }}" target="_blank">
                hier eine Vorschau herunterladen,
            </a> um zu sehen, wie das Formular aussehen wird.
        </p>
    {% endif %}

{% endblock %}

{% block additional_content %}
    <br>
    {% include('PaymentOrder/confirm/_confirmations.html.twig') %}

    <br>
    {% include('PaymentOrder/confirm/_payment_order_delete.html.twig') %}
{% endblock %}