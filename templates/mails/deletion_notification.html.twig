{% extends "mails/base_mail.html.twig" %}

{# @var payment_order \App\Entity\PaymentOrder #}

{% block content %}
    <row>
        <columns>
            <h4>{% trans %}payment_order.deletion_email.title{% endtrans %}</h4>
            <br>
            <p>{% trans with {'%fsb_email%': payment_order.department.fsr ? fsb_email : hhv_email} %}payment_order.deletion_email.info{% endtrans %}</p>

            {% if deleted_where == "backend" %}
                <p>Der Zahlungsauftrag wurde durch eine*n StuRa-Finanzer*in ({{ blame_user }}) gelöscht.</p>
            {% endif %}

            {% include "mails/_payment_order_table.html.twig" %}

            <br>

            <p>{% trans with {'%fsb_email%': payment_order.department.fsr ? fsb_email : hhv_email } %}payment_order.confirmation_mail.why{% endtrans %}</p>

        </columns>
    </row>

{% endblock %}