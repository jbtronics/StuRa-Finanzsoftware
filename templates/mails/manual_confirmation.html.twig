{% extends "mails/base_mail.html.twig" %}

{# @var payment_order \App\Entity\PaymentOrder #}

{% block content %}
    <row>
        <columns>
            <h4>{% trans %}payment_order.manual_confirmation.mail.title{% endtrans %}</h4>
            <br>
            <p>{% trans with {'%fsb_email%': payment_order.department.fsr ? fsb_email : hhv_email} %}payment_order.manual_confirmation.mail.info{% endtrans %}</p>

            <hr>

            <p>{% trans with {'%datetime%':  date()|format_datetime(), '%user%': user.fullName} %}payment_order.manual_confirmation.mail.confirmed_by{% endtrans %}</p>
            <p><b>{% trans %}payment_order.manual_confirmation.mail.reason{% endtrans %}</b>
            {{ reason }}
            </p>

            <hr>
            <br>

            {% include "mails/_payment_order_table.html.twig" %}

            <br>

            <p>{% trans with {'%fsb_email%': payment_order.department.fsr ? fsb_email : hhv_email } %}payment_order.confirmation_mail.why{% endtrans %}</p>

        </columns>
    </row>

{% endblock %}