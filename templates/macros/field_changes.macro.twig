{%- macro field(field_changes, field, symbol = "✎") -%}
    {% apply spaceless %}
        {# @var \App\Entity\FieldChanges field_changes #}
        {% if field_changes.wasChanged(field) %}
            <b style="font-size: larger; letter-spacing: -2px;">{{ symbol }}</b>&nbsp;
        {% endif %}
    {% endapply %}
{%- endmacro -%}

{%- macro icon(field_changes, field, icon = "fa-solid fa-user-pen text-primary") -%}
    {% apply spaceless %}
        {# @var \App\Entity\FieldChanges field_changes #}
        {% if field_changes.wasChanged(field) %}
            <i class="{{ icon }}" title="Letzte Änderung {{ field_changes.mostRecentChangeForField(field)['date'] | format_datetime("short") }} durch {{ field_changes.mostRecentChangeForField(field)['user'] }}"></i>&nbsp;
        {% endif %}
    {% endapply %}
{%- endmacro -%}